{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "family:lightsaber_cyan",
      "materials": {
        "default": "entity_alphablend",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/items/family_lightsaber_cyan_held",
        "tp": "textures/items/family_lightsaber_cyan_held_tp",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.family_sword",
        "tp": "geometry.family_sword_tp"
      },
      "animations": {
        "hold": "animation.family.wield",
        "hide": "animation.family.hide"
      },
      "scripts": {
        "pre_animation": [
          "variable.family_tp = c.is_first_person ? 0.0 : 1.0;"
        ],
        "animate": [
          {
            "hold": "context.item_slot != 'off_hand'"
          },
          {
            "hide": "context.item_slot == 'off_hand'"
          }
        ]
      },
      "render_controllers": [
        "controller.render.family_held"
      ]
    }
  }
}
