{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "family:lightsaber_blue",
      "materials": {
        "default": "entity_emissive_alpha",
        "enchanted": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/items/family_lightsaber_blue_held",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.family_item"
      },
      "scripts": {
        "pre_animation": [
          "v.main_hand = c.item_slot == 'main_hand';",
          "v.off_hand = c.item_slot == 'off_hand';",
          "v.head = c.item_slot == 'head';"
        ],
        "animate": [
          {
            "thirdperson_main_hand": "v.main_hand && !c.is_first_person"
          },
          {
            "thirdperson_off_hand": "v.off_hand && !c.is_first_person"
          },
          {
            "head": "v.head && !c.is_first_person"
          },
          {
            "firstperson_main_hand": "v.main_hand && c.is_first_person"
          },
          {
            "firstperson_off_hand": "v.off_hand && c.is_first_person"
          },
          {
            "firstperson_head": "c.is_first_person && v.head"
          }
        ]
      },
      "animations": {
        "thirdperson_main_hand": "animation.family.saber.thirdperson_main_hand",
        "thirdperson_off_hand": "animation.family.saber.thirdperson_off_hand",
        "head": "animation.family.saber.head",
        "firstperson_main_hand": "animation.family.saber.firstperson_main_hand",
        "firstperson_off_hand": "animation.family.saber.firstperson_off_hand",
        "firstperson_head": "animation.family.disable"
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
