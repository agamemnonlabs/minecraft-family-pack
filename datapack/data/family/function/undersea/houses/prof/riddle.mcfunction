scoreboard players enable @s family.talk
execute store result score #day family.house run time query gametime
scoreboard players operation #day family.house /= #day_ticks family.house
scoreboard players operation #r family.house = #day family.house
scoreboard players operation #r family.house %= #riddles family.house
execute if score @s family.riddle_day = #day family.house run return run dialog show @s {"type":"minecraft:notice","title":{"text":"Professor Periwinkle","color":"dark_aqua"},"body":[{"type":"minecraft:plain_message","contents":{"text":"You already solved today's riddle. Well done! A new one comes tomorrow."}}],"action":{"label":"OK!"}}
